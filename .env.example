# Google Gemini API configuration
# GEMINI_API_KEYS supports comma-separated keys from authorized projects for failover.
# Rate limits are generally enforced per Google Cloud / AI Studio project, not per API key.
GEMINI_API_KEYS=your_first_gemini_api_key,your_second_gemini_api_key
# GEMINI_API_KEY=your_single_gemini_api_key_fallback

# Model configuration (stable low-latency flash model)
GEMINI_MODEL=gemini-2.5-flash

# Latency and retry budget controls (in seconds)
GEMINI_REQUEST_TIMEOUT_SECONDS=8.0
GEMINI_TOTAL_BUDGET_SECONDS=25.0
GEMINI_KEY_COOLDOWN_SECONDS=60.0

PORT=8000